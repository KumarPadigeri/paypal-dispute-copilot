# Copy this file to .env and fill in your PayPal SANDBOX app keys.
# developer.paypal.com > Apps & Credentials > Sandbox > dispute-copilot
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Microsoft Foundry (auth via `az login`, no key needed)
FOUNDRY_ENDPOINT=https://kumarpadigeri-0341-resource.cognitiveservices.azure.com
FOUNDRY_DEPLOYMENT=gpt-5.4-mini

# Public demo (hosted app). Leave DEMO_PIN empty locally: everything is live.
DEMO_PIN=
DRAFT_DAILY_LIMIT=30
# Hosted app only: Foundry key (local development uses az login instead)
FOUNDRY_API_KEY=
# Where buyers send returns (offer refund after return): "line 1|city|state|postal|country".
# Empty = a made-up sandbox demo address.
RETURN_ADDRESS=
